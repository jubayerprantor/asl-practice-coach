{
  "name": "asl-practice-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx scripts/ingest.ts",
    "analyze": "tsx scripts/analyze.ts",
    "derive-thresholds": "tsx scripts/derive-thresholds.ts",
    "eval:harness": "tsx scripts/evaluate.ts",
    "verify:web": "tsx scripts/verify-web.ts",
    "build:desktop": "tsx scripts/package-desktop.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "com.aslpracticecoach.app",
    "productName": "ASL Practice Coach",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASL Practice Coach"
    }
  }
}
